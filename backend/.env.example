# Copy this file to `.env` (or set these as real OS/IDE environment variables)
# and fill in your local MySQL credentials. Spring Boot does not read `.env`
# files automatically — this is documentation only.
#
# PowerShell (current session):
#   $env:DB_USERNAME = "root"
#   $env:DB_PASSWORD = "your-password"
#
# Bash:
#   export DB_USERNAME=root
#   export DB_PASSWORD=your-password

DB_USERNAME=root
DB_PASSWORD=changeme
